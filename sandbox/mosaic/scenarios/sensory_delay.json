  "model": "mosaic-1998-1d",
  "condition": { "feedback_delay_steps": [0, 1, 2] },
  "realWorldAnalogy": "視覺或本體感覺慢了約 100–200 ms。只靠反射修正軌跡會震盪；forward model 的其中一個計算理由，就是在延遲回饋到達前先預測後果。",
  "beats": [
    {
      "trial": 30,
      "delaySteps": 0,
      "t": "switch_no_delay",
