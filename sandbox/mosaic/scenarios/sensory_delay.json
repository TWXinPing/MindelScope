      "watch": ["delay", "lambda_dist", "u_fb"]
    },
    {
      "trial": 30,
      "delaySteps": 1,
      "t": "switch_100ms",
      "caption": "延遲 100 ms：責任訊號切換變慢，回饋力開始不穩。",
      "watch": ["delay", "u_fb", "lambda_dist"]
    },
    {
      "trial": 30,
      "delaySteps": 2,
      "t": "switch_200ms",
      "caption": "延遲 200 ms：u_fb 震盪更明顯，gated learning 變差。這就是「為什麼需要預測」的現場。",
      "watch": ["delay", "u_fb", "fwd_1", "fwd_2"]
    }
  ]
